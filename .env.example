# ursGAL — docker compose орчны хувьсагчид (V4-15).
# Хуулаад бөглөнө: cp .env.example .env
# ⚠ .env-ийг ХЭЗЭЭ Ч git-д бүү оруул.

# Postgres container-ийн тохиргоо (db service)
POSTGRES_USER=ursgal_user
POSTGRES_PASSWORD=ursgal123
POSTGRES_DB=ursgal

# App → DB холболт. Docker дотор host нь "db" (compose service нэр).
DATABASE_URL=postgresql://ursgal_user:ursgal123@db:5432/ursgal?schema=public

# JWT нууцууд — production-д ЗААВАЛ шинээр үүсгэ: openssl rand -hex 32
JWT_SECRET=openssl_rand_hex_32_utga_1
JWT_REFRESH_SECRET=openssl_rand_hex_32_utga_2

# Гадагш нээх порт (default 3000)
APP_PORT=3000
