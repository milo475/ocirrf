generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  OPERATOR
  DRIVER
  WAREHOUSE // нярав (V5)
  SELLER // борлуулагч — линкийн хүсэлтийг батлаж хүргэлтэд гаргана (V5)
}

enum OrderStatus {
  NEW
  CONFIRMED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

/// Захиалга ирсэн суваг (V5) — DM-ээс шивэгддэг тул эх сурвалжийг тэмдэглэнэ
/// Хүсэлтийн төлөв (V5)
enum OrderRequestStatus {
  NEW // ажилтан хараагүй
  CONVERTED // захиалга болсон
  REJECTED // хогийн/буруу хүсэлт
}

enum OrderChannel {
  INSTAGRAM
  FACEBOOK
  PHONE
  OTHER
}

enum DeliveryRegion {
  ULAANBAATAR
  ORON_NUTAG
}

enum DeliveryStatus {
  PENDING
  ASSIGNED
  ON_THE_WAY
  DELIVERED
  FAILED
}

enum FinanceType {
  INCOME
  EXPENSE
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

/// Төлбөрийн хэлбэр — ЗӨВХӨН ШИЛЖҮҮЛЭГ (V5).
///
/// Компанийн шийдвэр: бэлэн мөнгөөр огт үйлчлэхгүй. Жолооч мөнгө
/// авч явахгүй, авах ч ёсгүй. Мөнгө дансанд орсны ДАРАА л бараа
/// хөдөлнө. Тиймээс CASH ба CARD-ыг системээс бүрмөсөн хассан —
/// сонголт байхгүй бол алдаа гарах, зөрчих ч боломжгүй.
enum PaymentMethod {
  TRANSFER
}

/// Жолоочийн ажлын төрөл (V5)
enum EmploymentType {
  FULL_TIME // үндсэн
  HOURLY // цагийн
}

enum PayoutStatus {
  PENDING
  PAID
}

/// Платформ дээрх app-ийн статус (App Registry)
enum AppStatus {
  ACTIVE // ашиглахад бэлэн
  COMING_SOON // каталогт харагдана, идэвхжүүлж болохгүй
  DISABLED // огт харагдахгүй
}

/// ПЛАТФОРМЫН APP КАТАЛОГ (App Registry) — Odoo маягийн олон дотоод
/// системийн бүртгэл. ursGAL нь эдгээрийн зөвхөн нэг нь.
///
/// АНХААР: платформын түвшний ГЛОБАЛ дата — байгууллагаас хамааралгүй
/// тул org-scope extension-ий SCOPED_MODELS-д ОРУУЛАХГҮЙ (жагсаалтад
/// байхгүй model-д extension огт үйлчилдэггүй).
model Application {
  id            String    @id @default(uuid())
  /// Тогтмол түлхүүр (жишээ: "ursgal") — production-д ороод ирвэл
  /// хэзээ ч өөрчлөгдөхгүй, frontend манифест үүгээр холбогдоно
  key           String    @unique
  nameMn        String
  nameEn        String
  descriptionMn String
  /// lucide icon-ий нэр (жишээ: "boxes")
  icon          String
  /// Card-ийн accent өнгө (hex)
  color         String
  status        AppStatus @default(COMING_SOON)
  sortOrder     Int       @default(100)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  organizationApps OrganizationApp[]
}

/// Аль байгууллага аль app-ийг идэвхжүүлсэн бэ (org-scoped).
/// Байгууллага устахад хамт устана (Cascade — join хүснэгт).
model OrganizationApp {
  id              String       @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  applicationId   String
  application     Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  enabledAt       DateTime     @default(now())
  /// Хэн идэвхжүүлсэн (register-org-ийн автомат идэвхжүүлэлтэд null)
  enabledByUserId String?
  enabledBy       User?        @relation(fields: [enabledByUserId], references: [id], onDelete: SetNull)

  @@unique([organizationId, applicationId])
}

/// ТҮРЭЭСЛЭГЧ БАЙГУУЛЛАГА (Multi-tenancy) — нэг deployment дээр олон
/// компани тус тусын бүрэн тусгаарлагдсан өгөгдөлтэй ажиллана.
///
/// Company-тай андуурахгүй: Company нь байгууллагын ДОТОРХ нийлүүлэгч
/// түнш; Organization нь системийг ашиглаж буй байгууллага өөрөө.
/// Scoped model бүр organizationId-тай бөгөөд org-scope extension
/// query бүрт автоматаар шүүлт нэмдэг (src/prisma/org-scope.extension.ts).
model Organization {
  id               String   @id @default(uuid())
  /// Санаатайгаар unique БИШ — нэр давхардаж болно (enumeration хаана)
  name             String
  phone            String?
  /// Нийтийн захиалгын линкийн нууц — /z/:token энэ баганаар орг-оо
  /// олдог тул ГЛОБАЛ unique. Setting-ийн publicOrderToken-оос нүүсэн.
  publicOrderToken String?  @unique
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())

  users          User[]
  companies      Company[]
  categories     Category[]
  products       Product[]
  orders         Order[]
  orderRequests  OrderRequest[]
  supplies       Supply[]
  handovers      DriverHandover[]
  payments       Payment[]
  financeEntries FinanceEntry[]
  driverPayouts  DriverPayout[]
  stockMoves     StockMovement[]
  batches        ProductBatch[]
  orderReturns   OrderReturn[]
  settings       Setting[]
  activityLogs   ActivityLog[]
  apps           OrganizationApp[]
}

model User {
  id                 String    @id @default(uuid())
  /// ГЛОБАЛ unique хэвээр (v1: нэг хэрэглэгч = яг нэг байгууллага) —
  /// login өөрчлөгдөхгүй, org сонгох шаардлагагүй
  username           String    @unique
  passwordHash       String
  fullName           String
  phone              String? // холбоо барих утас
  role               Role      @default(OPERATOR)
  isActive           Boolean   @default(true)
  /// ПЛАТФОРМЫН SUPERADMIN — байгууллага ДОТОРХ role-уудаас тусдаа,
  /// дээд давхаргын эрх: бүх байгууллага, app каталогийг удирдана.
  /// Зөвхөн scripts/make-superadmin.ts-ээр олгоно (UI-гаас олгохгүй).
  isSuperAdmin       Boolean   @default(false)
  /// Аль байгууллагын хэрэглэгч вэ (Multi-tenancy)
  organizationId     String
  /// Аль харилцагч компанийн хүн бэ (V5) — голдуу OPERATOR эрхтэйд
  companyId          String?
  /// Түр нууц үгээр нэвтэрсэн — солитол бусад API 403 (V4-06)
  mustChangePassword Boolean   @default(false)
  // Нэвтрэлтийн хамгаалалт (V4-07)
  lastLoginAt        DateTime?
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?
  createdAt          DateTime  @default(now())

  orders           Order[]           @relation("CreatedOrders")
  stockMoves       StockMovement[]
  assignedOrders   Order[]           @relation("AssignedOrders")
  warehouseOrders  Order[]           @relation("WarehouseOrders")
  handoversMade    DriverHandover[]  @relation("HandoversMade")
  handoversTaken   DriverHandover[]  @relation("HandoversTaken")
  driverProfile    DriverProfile?
  permissions      UserPermission[]
  financeEntries   FinanceEntry[]    @relation("FinanceEntries")
  driverPayouts    DriverPayout[]    @relation("DriverPayouts")
  payoutsCreated   DriverPayout[]    @relation("PayoutsCreated")
  notifications    Notification[]
  paymentsReceived Payment[]         @relation("PaymentsReceived")
  returnsCreated   OrderReturn[]     @relation("ReturnsCreated")
  refreshTokens    RefreshToken[]
  loginHistory     LoginHistory[]
  batchesCreated   ProductBatch[]    @relation("BatchesCreated")
  suppliesBrought  Supply[]          @relation("SuppliedBy")
  suppliesReceived Supply[]          @relation("SuppliesReceived")
  company          Company?          @relation(fields: [companyId], references: [id])
  organization     Organization      @relation(fields: [organizationId], references: [id])
  appsEnabled      OrganizationApp[]

  @@index([organizationId])
}

/// Refresh token rotation (V4-08): id = jti claim, DB-д зөвхөн hash.
/// revokedAt тавигдсан token ДАХИН ирвэл хулгайн шинж — эзний бүх
/// token revoke хийгдэнэ.
/// АМЖИЛТТАЙ НЭВТРЭЛТИЙН ТҮҮХ (V5).
///
/// Өмнө нь зөвхөн User.lastLoginAt шинэчлэгддэг байсан тул «хаанаас,
/// ямар төхөөрөмжөөр орсон бэ», «миний бүртгэлээр өөр хүн орсон уу»
/// гэдэгт хариулах ямар ч зам байсангүй.
///
/// Амжилтгүй оролдлого нь ActivityLog-д (entity='security') бичигддэг
/// — тэр нь хэрэглэгчгүй ч байж болдог тул тусдаа.
model LoginHistory {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Хүсэлт хаанаас ирсэн
  ip        String?
  /// Хөтөч/төхөөрөмжийн танилт (түүхий User-Agent)
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model RefreshToken {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  createdAt    DateTime  @default(now())

  @@index([userId])
}

/// Нийтийн линкээр ирсэн захиалгын хүсэлт (V5).
/// Хэрэглэгч өөрөө бөглөнө — ҮЛДЭГДЭЛД ХҮРЭХГҮЙ. Ажилтан мөнгө/хаягийг
/// шалгаад баталгаажуулсны дараа л жинхэнэ захиалга үүсч үлдэгдэл хасагдана.
model OrderRequest {
  id             String             @id @default(uuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id])
  status         OrderRequestStatus @default(NEW)

  // Хүлээн авагч
  customerName String
  phone        String
  extraPhone   String?
  /// IG/FB дээрх нэр — ажилтан аль ярианых болохыг таних
  socialName   String?
  channel      OrderChannel @default(OTHER)

  // Хаяг
  region        DeliveryRegion @default(ULAANBAATAR)
  district      String?
  khoroo        String?
  building      String?
  entrance      String?
  floor         String?
  door          String?
  province      String?
  soum          String?
  transport     String?
  addressDetail String?
  note          String?

  // Төлбөр — шилжүүлгийн баримтыг хэрэглэгч хавсаргана
  paid            Boolean @default(false)
  paymentProofUrl String?

  // Боловсруулалт
  /// Татгалзсан шалтгаан (V5) — «мөнгө ороогүй» тохиолдлыг тэмдэглэнэ
  rejectReason String?
  orderId      String?
  handledById  String?
  handledAt    DateTime?
  createdAt    DateTime  @default(now())

  items OrderRequestItem[]

  @@index([organizationId])
  @@index([status, createdAt])
}

model OrderRequestItem {
  id        String       @id @default(uuid())
  requestId String
  request   OrderRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  productId String
  qty       Int

  @@index([requestId])
}

/// Захиалгын буцаалт (v4) — бүтэн/хэсэгчилсэн
model OrderReturn {
  id                 String       @id @default(uuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id])
  orderId            String
  order              Order        @relation(fields: [orderId], references: [id])
  reason             String
  refundAmount       Decimal      @db.Decimal(12, 2)
  restocked          Boolean
  excludeFromPayroll Boolean      @default(false)
  createdById        String
  createdBy          User         @relation("ReturnsCreated", fields: [createdById], references: [id])
  createdAt          DateTime     @default(now())

  items OrderReturnItem[]

  @@index([organizationId])
  @@index([orderId])
}

model OrderReturnItem {
  id          String      @id @default(uuid())
  returnId    String
  return      OrderReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItemId String
  qty         Int
}

/// Жолоочид бараа хүлээлгэн өгсөн хуудас (V5).
/// Нярав захиалгуудыг нэг хуудсанд багцалж жолоочид хүлээлгэн өгнө.
/// Хуудсыг хэвлээд хоёр тал цаасан дээр нь гарын үсгээ зурна.
model DriverHandover {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  number         String // ХҮЛ-YYYYMMDD-NNN — байгууллага дотроо unique

  driverId String
  driver   User   @relation("HandoversTaken", fields: [driverId], references: [id])

  keeperId String
  keeper   User   @relation("HandoversMade", fields: [keeperId], references: [id])

  note String?

  handedAt  DateTime?
  createdAt DateTime  @default(now())

  orders Order[]

  @@unique([organizationId, number])
  @@index([driverId, createdAt])
}

/// Захиалгын төлбөрийн бүртгэл (бэлэн/шилжүүлэг/карт)
model Payment {
  id             String        @id @default(uuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  orderId        String
  order          Order         @relation(fields: [orderId], references: [id])
  amount         Decimal       @db.Decimal(12, 2)
  // 20260831180000_transfer_only migration DEFAULT 'TRANSFER' тавьсан —
  // schema-д тусгагдаагүй байсныг залруулав (drift арилгах)
  method         PaymentMethod @default(TRANSFER)
  note           String?
  receivedById   String
  receivedBy     User          @relation("PaymentsReceived", fields: [receivedById], references: [id])
  createdAt      DateTime      @default(now())

  @@index([organizationId])
  @@index([orderId])
}

/// Хэрэглэгчийн мэдэгдэл (хонх)
model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // DELIVERY_ASSIGNED / LOW_STOCK / DELIVERY_FAILED ...
  title     String
  body      String?
  refType   String? // order / product / payout ...
  refId     String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

/// Байгууллага тус бүрийн тохиргоо (key-value) — Multi-tenancy-ийн
/// дараа PK нь (organizationId, key) хос болсон
model Setting {
  organizationId String
  key            String
  value          String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, key])
}

/// Үйлдлийн түүх — амжилттай өөрчлөлт бүр (interceptor бичнэ)
model ActivityLog {
  id             String        @id @default(uuid())
  /// Аль байгууллагад хамаарах вэ. Нэвтрэлтийн ӨМНӨХ security event
  /// (танигдаагүй нэрээр амжилтгүй нэвтрэлт) байгууллагагүй тул NULL —
  /// тийм мөр аль ч байгууллагын логт харагдахгүй (платформын түвшний
  /// асуудал, SUPERADMIN ирэхээр шийдэгдэнэ).
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  /// Хэн хийсэн бэ. Аюулгүй байдлын үйл явдалд ХООСОН байж болно
  /// (V5): амжилтгүй нэвтрэлтэд хэрэглэгч танигдаагүй байдаг.
  userId         String?
  action         String // жишээ: "POST /api/orders", "permission_change"
  entity         String // orders / products / permissions ...
  entityId       String?
  meta           Json?
  createdAt      DateTime      @default(now())

  @@index([organizationId, createdAt])
  @@index([entity, createdAt])
  // 20260901120000_security_audit migration-аар нэмэгдсэн — schema-д
  // тусгагдаагүй байсныг залруулав (drift арилгах)
  @@index([action, createdAt])
}

/// Санхүүгийн гүйлгээ — гараар бүртгэсэн эсвэл системээс автомат (category "ORDER")
model FinanceEntry {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  type           FinanceType
  category       String
  amount         Decimal      @db.Decimal(12, 2)
  note           String?
  refOrderId     String? // автомат орлогод — эх захиалга
  refPaymentId   String? // PAYMENT орлогод — эх төлбөр (устгахад хамт устна)
  createdById    String
  createdBy      User         @relation("FinanceEntries", fields: [createdById], references: [id])
  entryDate      DateTime     @default(now())

  @@index([organizationId])
  @@index([type, entryDate])
  @@index([refOrderId])
}

/// Жолоочийн цалингийн тооцоо (нэг хугацааны багц)
model DriverPayout {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  driverId       String
  driver         User         @relation("DriverPayouts", fields: [driverId], references: [id])
  periodStart    DateTime
  periodEnd      DateTime
  deliveredCount Int
  feePerDelivery Decimal      @db.Decimal(12, 2)
  totalAmount    Decimal      @db.Decimal(12, 2)
  status         PayoutStatus @default(PENDING)
  paidAt         DateTime?
  createdById    String
  createdBy      User         @relation("PayoutsCreated", fields: [createdById], references: [id])
  orders         Order[]      @relation("PayoutOrders")

  @@index([organizationId])
  @@index([driverId])
}

/// Хэрэглэгч тус бүрийн permission override.
/// Effective = override байвал override, үгүй бол ROLE_DEFAULTS.
model UserPermission {
  id      String  @id @default(uuid())
  userId  String
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  permKey String
  allowed Boolean

  @@unique([userId, permKey])
}

/// Харилцагч компани (V5) — бараа нийлүүлдэг түнш байгууллага.
/// Оператор (=Харилцагч эрхтэй хэрэглэгч) болон бараа нь компанид харьяалагдана.
model Company {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String // байгууллага дотроо unique
  phone          String?
  note           String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())

  users    User[]
  products Product[]
  supplies Supply[]

  @@unique([organizationId, name])
}

/// Харилцагчийн НИЙЛҮҮЛЭЛТ (V5).
///
/// Өмнө нь бараа орлогод орох нь ердөө StockMovement(PURCHASE_IN) байсан
/// тул ХЭН нийлүүлсэн, ЯМАР ӨРТГӨӨР, ХЭД төлөх ёстойг систем мэддэггүй
/// байв — бүгд Excel дээр л байсан. Энэ модель тэр гурвыг хаана.
model Supply {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  number         String // НИЙ-YYYYMMDD-NNN — байгууллага дотроо unique

  companyId  String
  company    Company @relation(fields: [companyId], references: [id])
  /// Барааг авчирсан харилцагч хүн (OPERATOR) — мэдэгдэж болно
  supplierId String?
  supplier   User?   @relation("SuppliedBy", fields: [supplierId], references: [id])

  /// Хүлээж авсан ажилтан (нярав/менежер)
  receivedById String
  receivedBy   User   @relation("SuppliesReceived", fields: [receivedById], references: [id])

  totalCost  Decimal @db.Decimal(12, 2)
  /// Харилцагчид төлсөн дүн — үлдэгдэл нь бидний ӨР
  paidAmount Decimal @default(0) @db.Decimal(12, 2)

  note      String?
  createdAt DateTime @default(now())

  items   SupplyItem[]
  batches ProductBatch[]

  @@unique([organizationId, number])
  @@index([companyId, createdAt])
}

/// Барааны ЦУВРАЛ — хугацаа хянах нэгж (V5).
///
/// Хүнсний нэмэлт бүтээгдэхүүн хугацаатай тул «хэдэн ширхэг байна»
/// гэдэг хангалтгүй: аль нь хэзээ дуусахыг мэдэх ёстой. Цуврал нь
/// нийлүүлэлт хүлээж авахад үүснэ (эсвэл хуучин үлдэгдэлд гараар).
///
/// ЧУХАЛ: Product.stockQty нь үлдэгдлийн ЦОРЫН ГАНЦ эх сурвалж хэвээр.
/// Цуврал нь түүнийг ХУГАЦААГААР задалж харуулна — бараа цувралгүй ч
/// бүрэн ажиллана (хугацаагүй бараанд цуврал шаардлагагүй).
model ProductBatch {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  productId      String
  product        Product      @relation(fields: [productId], references: [id])

  /// Үйлдвэрийн цувралын дугаар — заавал биш
  batchNo    String?
  expiryDate DateTime

  /// Хүлээж авсан тоо ба ҮЛДСЭН тоо (0 бол дууссан/хаагдсан)
  qty       Int
  remaining Int

  /// Аль нийлүүлэлтээр орж ирсэн (гараар нэмсэн бол хоосон)
  supplyId String?
  supply   Supply? @relation(fields: [supplyId], references: [id])

  /// Устгалд гарсан эсэх — хугацаа дуусч хассан цуврал
  writtenOffAt DateTime?

  note        String?
  createdById String
  createdBy   User     @relation("BatchesCreated", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([organizationId])
  @@index([productId, expiryDate])
  @@index([expiryDate])
}

model SupplyItem {
  id       String @id @default(uuid())
  supplyId String
  supply   Supply @relation(fields: [supplyId], references: [id], onDelete: Cascade)

  productId   String
  product     Product @relation(fields: [productId], references: [id])
  productName String // snapshot
  qty         Int
  unitCost    Decimal @db.Decimal(12, 2)
  lineTotal   Decimal @db.Decimal(12, 2)

  @@index([supplyId])
}

model Category {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String // байгууллага дотроо unique
  products       Product[]

  @@unique([organizationId, name])
}

model Product {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  sku            String // байгууллага дотроо unique
  barcode        String? // штрих код (V4-12) — байгууллага дотроо unique
  name           String
  price          Decimal      @db.Decimal(12, 2)
  costPrice      Decimal      @default(0) @db.Decimal(12, 2) // өртөг (v4) — сүүлийн орлогын үнэ
  stockQty       Int          @default(0)
  lowStockLimit  Int          @default(5) // үүнээс доош орвол анхааруулга
  /// Нэг ширхэг нь хэрэглэгчид ХЭДЭН ХОНОГ хүрэх вэ (V5).
  /// Давтан захиалгын таамаглалд ашиглана — нэмэлт бүтээгдэхүүн
  /// дуусах дөхөхөд үйлчлүүлэгчид сануулна.
  ///   null → тохиргооны ерөнхий утгыг хэрэглэнэ
  ///   0    → энэ бараа давтан захиалгад ОРОХГҮЙ (сав, багаж гэх мэт)
  ///   N    → N хоног
  daysSupply     Int?
  unit           String       @default("ш")
  imageUrl       String?
  isActive       Boolean      @default(true)
  categoryId     String?
  /// Аль харилцагч компанийн бараа вэ (V5)
  companyId      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  category    Category?       @relation(fields: [categoryId], references: [id])
  company     Company?        @relation(fields: [companyId], references: [id])
  orderItems  OrderItem[]
  stockMoves  StockMovement[]
  supplyItems SupplyItem[]
  batches     ProductBatch[]

  @@unique([organizationId, sku])
  @@unique([organizationId, barcode])
  @@index([organizationId, isActive])
  @@index([name])
  @@index([isActive])
}

model Order {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  orderNo        String // ORD-YYYYMMDD-NNNN — байгууллага дотроо unique
  customerName   String? // Хүлээн авагчийн нэр (заавал биш)
  phone          String // Хүлээн авагчийн утас — заавал
  extraPhone     String? // Нэмэлт (захиалагчийн) утас

  // Бүтэцлэгдсэн хаяг (v2 нэмэлт багц)
  region        DeliveryRegion @default(ULAANBAATAR)
  // УБ горим:
  district      String? // Дүүрэг
  khoroo        String? // Хороо
  building      String? // Барилга / Хороолол / Хашаа
  entrance      String? // Орц
  floor         String? // Давхар
  door          String? // Хаалга
  // Орон нутаг горим:
  province      String? // Аймаг
  soum          String? // Сум / Суурин газар
  transport     String? // Ачаа явах тээвэр (орон нутагт заавал)
  addressDetail String? // Хаягийн дэлгэрэнгүй (чөлөөт текст)

  note           String?
  channel        OrderChannel   @default(OTHER) // захиалга ирсэн суваг (V5)
  totalAmount    Decimal        @default(0) @db.Decimal(12, 2)
  orderStatus    OrderStatus    @default(NEW)
  deliveryStatus DeliveryStatus @default(PENDING)
  createdById    String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  /// Аль нярав бэлтгэх вэ (V5) — менежер жолооч хуваарилсны дараа онооно
  warehouseId String?
  /// Аль хүлээлгэн өгөх хуудсанд орсон бэ (V5)
  handoverId  String?

  // Хүргэлт (v2)
  assignedDriverId String?
  assignedAt       DateTime?
  deliveredAt      DateTime?
  deliveryProofUrl String? // баталгаажуулах зургийн зам
  deliveryNote     String? // жолоочийн тэмдэглэл (амжилтгүй бол шалтгаан)

  // Санхүү (v3): аль цалингийн тооцоонд орсныг тэмдэглэнэ
  payoutId String?

  // Төлбөр (v4): ОРЛОГО = ТӨЛБӨР — хүргэлт биш төлбөрөөр орлого бүртгэгдэнэ
  paymentStatus PaymentStatus @default(UNPAID)
  paidAmount    Decimal       @default(0) @db.Decimal(12, 2)

  // Буцаалт (v4): null = буцаалтгүй, PARTIAL / FULL
  returnState String?

  // Жолоочийн маршрутын дараалал (1..n, тухайн жолоочийн идэвхтэй хүргэлтэд)
  routeOrder Int?

  createdBy      User            @relation("CreatedOrders", fields: [createdById], references: [id])
  assignedDriver User?           @relation("AssignedOrders", fields: [assignedDriverId], references: [id])
  warehouse      User?           @relation("WarehouseOrders", fields: [warehouseId], references: [id])
  handover       DriverHandover? @relation(fields: [handoverId], references: [id])
  payout         DriverPayout?   @relation("PayoutOrders", fields: [payoutId], references: [id])
  items          OrderItem[]
  payments       Payment[]
  returns        OrderReturn[]

  @@unique([organizationId, orderNo])
  @@index([orderStatus])
  @@index([phone])
  @@index([createdAt])
  @@index([assignedDriverId])
}

model OrderItem {
  id           String  @id @default(uuid())
  orderId      String
  productId    String
  productName  String // snapshot
  qty          Int
  priceAtOrder Decimal @db.Decimal(12, 2)
  costAtOrder  Decimal @default(0) @db.Decimal(12, 2) // өртгийн snapshot (v4)
  lineTotal    Decimal @db.Decimal(12, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
}

model DriverProfile {
  id             String         @id @default(uuid())
  userId         String         @unique
  feePerDelivery Decimal        @db.Decimal(12, 2) // хүргэлт тутмын хөлс
  vehicleInfo    String?
  isAvailable    Boolean        @default(true)
  /// Ажлын төрөл (V5): үндсэн ажилтан эсвэл цагийн
  employmentType EmploymentType @default(FULL_TIME)
  /// Харьяалах бүс — дүүргийн товчлолууд (V5), ж: ["ХУД", "БЗД"]
  zones          String[]       @default([])

  user User @relation(fields: [userId], references: [id])
}

model StockMovement {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  productId      String
  qtyChange      Int // + орлого, - зарлага
  reason         String // "PURCHASE_IN", "MANUAL_OUT", "CORRECTION", "ORDER", "ORDER_CANCEL", "INITIAL"
  note           String? // нэмэлт тайлбар (v2)
  refId          String? // захиалгын id гэх мэт
  userId         String
  createdAt      DateTime     @default(now())

  product Product @relation(fields: [productId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([productId])
}
