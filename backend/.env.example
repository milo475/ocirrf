# ocirrf backend орчны хувьсагчид.
# Хуулаад бөглөнө: cp .env.example .env
# ⚠ .env-ийг ХЭЗЭЭ Ч git-д бүү оруул (.gitignore-д байгаа).

# PostgreSQL холболт. Production-д: нууц үгээ соль, боломжтой бол
# тусдаа DB сервер/хэрэглэгч, sslmode=require нэм.
# Docker compose-оор ажиллуулбал host нь localhost биш "db" (V4-15,
# root-ын .env.example-ийг хар):
#   postgresql://ocirrf_user:...@db:5432/ocirrf?schema=public
DATABASE_URL="postgresql://ocirrf_user:НУУЦ_ҮГЭЭ_СОЛЬ@localhost:5432/ocirrf?schema=public"

# JWT нууцууд — production-д ЗААВАЛ шинээр үүсгэ:
#   openssl rand -hex 32
JWT_SECRET="openssl_rand_hex_32_utga_1"
JWT_REFRESH_SECRET="openssl_rand_hex_32_utga_2"

# Сервер сонсох порт
PORT=3000

# Цагийн бүс (тавиагүй бол main.ts Asia/Ulaanbaatar болгоно)
# TZ=Asia/Ulaanbaatar

# И-мэйл — нууц үг сэргээх («Нууц үг мартсан?») холбоос илгээнэ.
# SMTP_HOST тавиагүй бол (dev/test) захидал илгээгдэхгүй, лог руу хэвлэгдэнэ.
# SMTP_HOST=smtp.example.mn
# SMTP_PORT=587
# SMTP_USER=noreply@example.mn
# SMTP_PASS=
# SMTP_SECURE=0            # 1 = TLS (465)
# MAIL_FROM="ocirrf <noreply@example.mn>"
# APP_URL=https://app.example.mn   # захидал дахь холбоосын хаяг (default http://localhost:3000)

# Хүргэлтийн баталгаажуулах зургийн хавтас.
# Заагаагүй бол backend/uploads. Production-д кодоос гадуурх зам зөвлөнө:
# UPLOADS_DIR="/var/lib/ocirrf/uploads"

# Frontend тусдаа домэйнд байршвал л хэрэгтэй (нэг порт дээр бол хэрэггүй)
# CORS_ORIGIN="https://ocirrf.example.mn"

# Reverse proxy (nginx/Caddy) ард ажиллуулбал ЗААВАЛ: rate limit, нэвтрэлтийн
# түүх жинхэнэ клиентийн IP-г ашиглана. Утга: hop-ийн тоо ("1"), "loopback",
# эсвэл proxy-гийн IP/CIDR. Шууд интернэтэд байвал тохируулахгүй.
# TRUST_PROXY="1"
